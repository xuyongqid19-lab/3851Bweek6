# Copy this file to .env in the project root. Never commit .env.
# QQ mailbox -> Settings -> Account / Account security -> POP3/IMAP/SMTP
# Enable SMTP and generate an authorization code (NOT your QQ login password).
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-qq-number@qq.com
SMTP_PASS=replace-with-qq-smtp-authorization-code
# Generate a private random value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RESET_CODE_SECRET=replace-with-your-own-random-secret-at-least-32-characters
